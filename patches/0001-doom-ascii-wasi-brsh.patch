+int DG_IsHalfBlockMode(void)
+{
+	int mode = 0;
+	if (M_CheckParm("-blocks") > 0 || M_CheckParm("--blocks") > 0
+		|| M_CheckParm("-block") > 0 || M_CheckParm("--block") > 0) {
+		mode = 1;
+	}
+	int i = M_CheckParmWithArgs("-chars", 1);
+	if (i > 0) {
+		const char *arg = myargv[i + 1];
+		if (!strcasecmp("color", arg) || !strcasecmp("colour", arg)
+			|| !strcasecmp("halfblock", arg) || !strcasecmp("halfblocks", arg)
+			|| !strcasecmp("blocks", arg)) {
+			mode = 1;
+		} else {
+			mode = 0;
+		}
+	}
+	return mode;
+}
+
+static size_t DG_CalcOutputBufferSize(unsigned int w, unsigned int h)
+{
+	if (character_set == HALFBLOCK) {
+		unsigned int rows = (h + 1U) / 2U;
+		return ((color_enabled ? 38U : 0U) + 3U) * (size_t)w * (size_t)rows
+			+ (size_t)rows * 64U + 4096U;
+	}
+	return ((color_enabled ? 19U : 0U) + (character_set == ASCII ? 2U : 6U))
+			* (size_t)w * (size_t)h
+		+ (size_t)h * 32U + 2048U;
+}
