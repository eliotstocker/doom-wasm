+	/* Fit within max_w and max_h maintaining 16:10 aspect ratio (w / h = 8 / 5) */
+	unsigned int w = max_w;
+	unsigned int h = (w * 5 + 4) / 8;
+	if (h > max_h) {
+		h = max_h;
+		w = (h * 8) / 5;
+	}
+	if (w > max_w) w = max_w;
+	if (h > max_h) h = max_h;
+	if (halfblock && h > 10) {
+		h &= ~1U;
+	}
+	if (w < 16) w = 16;
+	if (h < 10) h = 10;
+
+	*out_w = w;
+	*out_h = h;
