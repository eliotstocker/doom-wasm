+		int s = atoi(myargv[i + 1]);
+		if (s <= 0) s = 4;
+		*out_w = SCREENWIDTH / s;
+		*out_h = SCREENHEIGHT / s;
+		return;
+	}
+
+	int w_arg = M_CheckParmWithArgs("-width", 1);
+	int h_arg = M_CheckParmWithArgs("-height", 1);
+	if (w_arg > 0 && h_arg > 0) {
+		*out_w = (unsigned int)atoi(myargv[w_arg + 1]);
+		*out_h = (unsigned int)atoi(myargv[h_arg + 1]);
