+void DG_SetTerminalSize(int cols, int rows)
+{
+	if (cols <= 0 || rows <= 0) return;
+	int dims_changed = ((unsigned int)cols != DG_TermCols || (unsigned int)rows != DG_TermRows);
+	DG_TermCols = (unsigned int)cols;
+	DG_TermRows = (unsigned int)rows;
+
+	struct winsize ws = { .ws_row = (unsigned short)rows, .ws_col = (unsigned short)cols };
+	ioctl(STDIN_FILENO, TIOCSWINSZ, &ws);
+
+	if (!DG_ScreenBuffer) {
+		return; /* Will be created with these dimensions during dg_Create */
+	}
+
+	unsigned int new_w = 0, new_h = 0;
+	DG_ComputeResolution(cols, rows, &new_w, &new_h);
+
+	if (new_w == DOOMGENERIC_RESX && new_h == DOOMGENERIC_RESY) {
+		if (dims_changed) {
+			DG_ResizeOutputBuffer(new_w, new_h);
+			(void)write(STDOUT_FILENO, "\033[2J\033[1;1H", 10);
+		}
+		return;
+	}
+
+	DOOMGENERIC_RESX = new_w;
+	DOOMGENERIC_RESY = new_h;
+
+	void *new_buf = realloc(DG_ScreenBuffer, (unsigned long)new_w * new_h * 4);
+	if (new_buf) {
+		DG_ScreenBuffer = (uint32_t *)new_buf;
+	}
+
+	I_UpdateVideoResolution(new_w, new_h);
+	DG_ResizeOutputBuffer(new_w, new_h);
+
+	/* Clear terminal screen to remove borders from previous resolution */
+	(void)write(STDOUT_FILENO, "\033[2J\033[1;1H", 10);
+}
+
+#if defined(__wasm__)
+__attribute__((export_name("set_terminal_size")))
+#endif
+void set_terminal_size(int cols, int rows)
+{
+	DG_SetTerminalSize(cols, rows);
+}
+
+void dg_Create()
+{
+	/* Query terminal size via ioctl if not already set */
+	struct winsize ws;
+	if (ioctl(STDIN_FILENO, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0 && ws.ws_row > 0) {
+		DG_TermCols = ws.ws_col;
+		DG_TermRows = ws.ws_row;
 	}
+	if (DG_TermCols == 0) DG_TermCols = 80;
+	if (DG_TermRows == 0) DG_TermRows = 24;
+
+	DG_ComputeResolution(DG_TermCols, DG_TermRows, &DOOMGENERIC_RESX, &DOOMGENERIC_RESY);
 
 	DG_ScreenBuffer = malloc((unsigned long)DOOMGENERIC_RESX * DOOMGENERIC_RESY * 4);
 
