+static inline char *put_u8(char *buf, unsigned int v)
+{
+	if (v >= 100U) {
+		*buf++ = (char)('0' + v / 100U);
+		v %= 100U;
+		*buf++ = (char)('0' + v / 10U);
+		*buf++ = (char)('0' + v % 10U);
+	} else if (v >= 10U) {
+		*buf++ = (char)('0' + v / 10U);
+		*buf++ = (char)('0' + v % 10U);
+	} else {
+		*buf++ = (char)('0' + v);
+	}
+	return buf;
+}
+
+static inline char *put_uint(char *buf, unsigned int v)
+{
+	char tmp[12];
+	int n = 0;
+	do {
+		tmp[n++] = (char)('0' + (v % 10U));
+		v /= 10U;
+	} while (v > 0U);
+	while (n > 0) {
+		*buf++ = tmp[--n];
+	}
+	return buf;
+}
+
+static inline char *put_fg_rgb(char *buf, struct color_t c)
+{
+	BUF_PUTS(buf, "\033[38;2;");
+	buf = put_u8(buf, c.r);
+	*buf++ = ';';
+	buf = put_u8(buf, c.g);
+	*buf++ = ';';
+	buf = put_u8(buf, c.b);
+	*buf++ = 'm';
+	return buf;
+}
+
+static inline char *put_bg_rgb(char *buf, struct color_t c)
+{
+	BUF_PUTS(buf, "\033[48;2;");
+	buf = put_u8(buf, c.r);
+	*buf++ = ';';
+	buf = put_u8(buf, c.g);
+	*buf++ = ';';
+	buf = put_u8(buf, c.b);
+	*buf++ = 'm';
+	return buf;
+}
+
+static inline char *put_fg_bg_rgb(char *buf, struct color_t fg, struct color_t bg)
+{
+	BUF_PUTS(buf, "\033[38;2;");
+	buf = put_u8(buf, fg.r);
+	*buf++ = ';';
+	buf = put_u8(buf, fg.g);
+	*buf++ = ';';
+	buf = put_u8(buf, fg.b);
+	BUF_PUTS(buf, ";48;2;");
+	buf = put_u8(buf, bg.r);
+	*buf++ = ';';
+	buf = put_u8(buf, bg.g);
+	*buf++ = ';';
+	buf = put_u8(buf, bg.b);
+	*buf++ = 'm';
+	return buf;
+}
+
+static inline bool rgb_close(struct color_t a, struct color_t b, int tol)
+{
+	int dr = (int)a.r - (int)b.r;
+	if (dr < -tol || dr > tol) return false;
+	int dg = (int)a.g - (int)b.g;
+	if (dg < -tol || dg > tol) return false;
+	int db = (int)a.b - (int)b.b;
+	return db >= -tol && db <= tol;
+}
