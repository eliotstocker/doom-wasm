+static void write_all_stdout(const char *data, size_t len)
+{
+	if (len == 0) return;
+#ifdef OS_WINDOWS
+	fwrite(data, 1, len, stdout);
+	fflush(stdout);
+#else
+	const char *p = data;
+	size_t rem = len;
+	while (rem > 0) {
+		ssize_t n = write(STDOUT_FILENO, p, rem);
+		if (n > 0) {
+			p += (size_t)n;
+			rem -= (size_t)n;
+		} else if (n < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) {
+			continue;
+		} else {
+			break;
+		}
+	}
+#endif
+}
