+static void DG_ComputeResolution(int cols, int rows, unsigned int *out_w, unsigned int *out_h)
 {
-	int i;
-	i = M_CheckParmWithArgs("-scaling", 1);
+	int i = M_CheckParmWithArgs("-scaling", 1);
 	if (i > 0) {
-		i = atoi(myargv[i + 1]);
-		DOOMGENERIC_RESX = SCREENWIDTH / i;
-		DOOMGENERIC_RESY = SCREENHEIGHT / i;
+		int s = atoi(myargv[i + 1]);
+		if (s <= 0) s = 4;
+		*out_w = SCREENWIDTH / s;
+		*out_h = SCREENHEIGHT / s;
+		return;
+	}
+
+	int w_arg = M_CheckParmWithArgs("-width", 1);
+	int h_arg = M_CheckParmWithArgs("-height", 1);
+	if (w_arg > 0 && h_arg > 0) {
+		*out_w = (unsigned int)atoi(myargv[w_arg + 1]);
+		*out_h = (unsigned int)atoi(myargv[h_arg + 1]);
+		return;
+	}
+
+	if (cols <= 0) cols = 80;
+	if (rows <= 0) rows = 24;
+
+	int halfblock = DG_IsHalfBlockMode();
+
+	/* In half-block mode each cell is 1 pixel wide x 2 pixels tall;
+	 * otherwise each pixel is rendered 2 terminal characters wide x 1 row tall. */
+	unsigned int max_w = halfblock ? (unsigned int)cols : (unsigned int)(cols / 2);
+	unsigned int max_h = halfblock ? (unsigned int)(rows * 2) : (unsigned int)rows;
+
+	if (max_w > SCREENWIDTH) max_w = SCREENWIDTH;
+	if (max_h > SCREENHEIGHT) max_h = SCREENHEIGHT;
+	if (max_w < 16) max_w = 16;
+	if (max_h < 10) max_h = 10;
+
+	if (M_CheckParm("-stretch") > 0) {
+		*out_w = max_w;
+		*out_h = (halfblock && max_h > 10) ? (max_h & ~1U) : max_h;
+		return;
+	}
+
+	/* Fit within max_w and max_h maintaining 16:10 aspect ratio (w / h = 8 / 5) */
+	unsigned int w = max_w;
+	unsigned int h = (w * 5 + 4) / 8;
+	if (h > max_h) {
+		h = max_h;
+		w = (h * 8) / 5;
+	}
+	if (w > max_w) w = max_w;
+	if (h > max_h) h = max_h;
+	if (halfblock && h > 10) {
+		h &= ~1U;
+	}
+	if (w < 16) w = 16;
+	if (h < 10) h = 10;
+
+	*out_w = w;
+	*out_h = h;
+}
+
+void DG_SetTerminalSize(int cols, int rows)
+{
+	if (cols <= 0 || rows <= 0) return;
+	DG_TermCols = (unsigned int)cols;
+	DG_TermRows = (unsigned int)rows;
+
+	struct winsize ws = { .ws_row = (unsigned short)rows, .ws_col = (unsigned short)cols };
+	ioctl(STDIN_FILENO, TIOCSWINSZ, &ws);
+
+	if (!DG_ScreenBuffer) {
+		return; /* Will be created with these dimensions during dg_Create */
+	}
+
+	unsigned int new_w = 0, new_h = 0;
+	DG_ComputeResolution(cols, rows, &new_w, &new_h);
+
+	if (new_w == DOOMGENERIC_RESX && new_h == DOOMGENERIC_RESY) {
+		return;
+	}
+
+	DOOMGENERIC_RESX = new_w;
+	DOOMGENERIC_RESY = new_h;
+
+	void *new_buf = realloc(DG_ScreenBuffer, (unsigned long)new_w * new_h * 4);
+	if (new_buf) {
+		DG_ScreenBuffer = (uint32_t *)new_buf;
+	}
+
+	I_UpdateVideoResolution(new_w, new_h);
+	DG_ResizeOutputBuffer(new_w, new_h);
+
+	/* Clear terminal screen to remove borders from previous resolution */
+	fputs("\033[2J\033[1;1H", stdout);
+	fflush(stdout);
+}
+
+#if defined(__wasm__)
+__attribute__((export_name("set_terminal_size")))
+#endif
+void set_terminal_size(int cols, int rows)
+{
+	DG_SetTerminalSize(cols, rows);
+}
+
+void dg_Create()
+{
+	/* Query terminal size via ioctl if not already set */
+	struct winsize ws;
+	if (ioctl(STDIN_FILENO, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0 && ws.ws_row > 0) {
+		DG_TermCols = ws.ws_col;
+		DG_TermRows = ws.ws_row;
 	}
+	if (DG_TermCols == 0) DG_TermCols = 80;
+	if (DG_TermRows == 0) DG_TermRows = 24;
+
+	DG_ComputeResolution(DG_TermCols, DG_TermRows, &DOOMGENERIC_RESX, &DOOMGENERIC_RESY);
 
 	DG_ScreenBuffer = malloc((unsigned long)DOOMGENERIC_RESX * DOOMGENERIC_RESY * 4);
 
