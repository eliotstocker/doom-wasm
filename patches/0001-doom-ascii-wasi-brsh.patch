+	int halfblock = DG_IsHalfBlockMode();
+
+	/* In half-block mode each cell is 1 pixel wide x 2 pixels tall;
+	 * otherwise each pixel is rendered 2 terminal characters wide x 1 row tall. */
+	unsigned int max_w = halfblock ? (unsigned int)cols : (unsigned int)(cols / 2);
+	unsigned int max_h = halfblock ? (unsigned int)(rows * 2) : (unsigned int)rows;
+
+	if (max_w > SCREENWIDTH) max_w = SCREENWIDTH;
+	if (max_h > SCREENHEIGHT) max_h = SCREENHEIGHT;
+	if (max_w < 16) max_w = 16;
+	if (max_h < 10) max_h = 10;
+
+	if (M_CheckParm("-stretch") > 0) {
+		*out_w = max_w;
+		*out_h = (halfblock && max_h > 10) ? (max_h & ~1U) : max_h;
+		return;
+	}
